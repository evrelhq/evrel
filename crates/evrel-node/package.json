{
  "name": "@evrel/compiler",
  "version": "0.1.0-alpha.2",
  "description": "The Evrel JavaScript and TypeScript compiler",
  "keywords": [
    "aot",
    "compiler",
    "javascript",
    "typescript"
  ],
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "require": "./index.js",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "*.node"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evrelhq/evrel.git",
    "directory": "crates/evrel-node"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "create-native-packages": "napi create-npm-dirs --npm-dir npm",
    "assemble-native-packages": "napi artifacts --npm-dir npm",
    "prepare-native-packages": "napi pre-publish --tag-style npm --no-gh-release --skip-optional-publish",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "test": "pnpm run build:debug && pnpm run type-check && node --test test/bindings.test.cjs"
  },
  "napi": {
    "binaryName": "evrel",
    "packageName": "@evrel/compiler-binding",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "aarch64-pc-windows-msvc",
      "x86_64-pc-windows-msvc",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-musl",
      "x86_64-unknown-linux-musl"
    ]
  },
  "devDependencies": {
    "@napi-rs/cli": "catalog:",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@10.30.3"
}
